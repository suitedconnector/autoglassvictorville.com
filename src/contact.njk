---
layout: layouts/base.njk
title: Contact Us & Free Quote
description: Contact Auto Glass Victorville for a free quote on windshield repair, auto glass replacement, or mobile service in the High Desert.
schema: |
  {
    "@context": "https://schema.org",
    "@type": "AutoRepair",
    "name": "Auto Glass Victorville",
    "description": "Auto glass repair and replacement in Victorville, CA",
    "telephone": "(760) 555-0100",
    "email": "info@autoglassvictorville.com",
    "url": "https://autoglassvictorville.com/contact/",
    "areaServed": ["Victorville, CA", "Hesperia, CA", "Apple Valley, CA", "Adelanto, CA", "Oak Hills, CA"]
  }
---

<section class="hero" style="background-image: url(/assets/honda-civic-broken-windshield.jpg); background-size: cover; background-position: center; position: relative;">
  <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4);"></div>
  <div class="container" style="position: relative; z-index: 1;">
    <h1>Contact Us</h1>
    <p class="hero-subtitle">Free quotes — call, or send us the details below</p>
  </div>
</section>

<section class="content-section">
  <div class="container">
    <div class="service-content">
      <h2>Get Your Free Quote</h2>
      <p>Call us for an instant quote — we're here to help. Or fill out the form below and we'll contact you right away.</p>

      <div class="quote-form" style="max-width: 560px;">
        <h3>Request a Quote</h3>
        <div id="successMessage" style="display: none; background: #d4edda; color: #155724; padding: 1rem; margin-bottom: 1rem; border-radius: 4px; border: 1px solid #c3e6cb;">
          ✓ Thank you! Your quote request has been received. We'll contact you shortly.
        </div>
        <div id="errorMessage" style="display: none; background: #f8d7da; color: #721c24; padding: 1rem; margin-bottom: 1rem; border-radius: 4px; border: 1px solid #f5c6cb;">
          <span id="errorText"></span>
        </div>
        <form id="quoteForm" enctype="multipart/form-data">
          <input type="text" name="name" placeholder="Your Name" required>
          <input type="tel" name="phone" placeholder="Phone Number" required>

          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.75rem;">
            <select id="yearSelect" name="year" required>
              <option value="">Year</option>
              {% for year in vehicles.years %}
              <option value="{{ year }}">{{ year }}</option>
              {% endfor %}
            </select>

            <select id="makeSelect" name="make" required>
              <option value="">Make</option>
            </select>

            <select id="modelSelect" name="model" required>
              <option value="">Model</option>
            </select>
          </div>

          <input type="text" id="customModel" name="customModel" placeholder="Enter custom model" style="display: none;">

          <select name="service" required>
            <option value="">Select Service</option>
            {% for service in site.services %}
            <option value="{{ service.name }}">{{ service.name }}</option>
            {% endfor %}
            <option value="Not sure">Not sure</option>
          </select>
          <select name="location">
            <option value="">Your City</option>
            {% for location in site.locations %}
            <option value="{{ location.name }}">{{ location.name }}</option>
            {% endfor %}
            <option value="Other">Other</option>
          </select>
          <textarea name="message" placeholder="Describe the damage (size, location on glass, when it happened)..." rows="4"></textarea>

          <div style="margin: 1rem 0;">
            <label style="display: block; font-weight: 500; margin-bottom: 0.5rem;">Photo of damage (optional)</label>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
              <div>
                <input type="file" id="photo-upload" name="photo" accept="image/*" style="display: none;">
                <label for="photo-upload" style="display: block; padding: 0.75rem; background: #f3f4f6; border: 2px solid #e5e7eb; border-radius: 0.375rem; text-align: center; cursor: pointer; font-weight: 500; transition: all 0.2s;">📁 Upload</label>
              </div>
              <div>
                <input type="file" id="photo-camera" name="photo" accept="image/*" capture="environment" style="display: none;">
                <label for="photo-camera" style="display: block; padding: 0.75rem; background: #f3f4f6; border: 2px solid #e5e7eb; border-radius: 0.375rem; text-align: center; cursor: pointer; font-weight: 500; transition: all 0.2s;">📷 Camera</label>
              </div>
            </div>
          </div>

          <button type="submit" class="cta-button">Send Quote Request</button>
        </form>
      </div>

      <script>
        const vehicleData = {{ vehicles | dump | safe }};

        function updateMakes() {
          const year = document.getElementById('yearSelect').value;
          const makeSelect = document.getElementById('makeSelect');
          makeSelect.innerHTML = '<option value="">Make</option>';

          if (year) {
            const makes = [...new Set(vehicleData.vehicles
              .filter(v => v.year == year)
              .map(v => v.make))];
            makes.forEach(make => {
              makeSelect.innerHTML += `<option value="${make}">${make}</option>`;
            });
          }
          updateModels();
        }

        function updateModels() {
          const year = document.getElementById('yearSelect').value;
          const make = document.getElementById('makeSelect').value;
          const modelSelect = document.getElementById('modelSelect');
          modelSelect.innerHTML = '<option value="">Model</option>';

          if (year && make) {
            const models = vehicleData.vehicles
              .filter(v => v.year == year && v.make === make)
              .map(v => v.model);
            models.forEach(model => {
              modelSelect.innerHTML += `<option value="${model}">${model}</option>`;
            });
          }
          toggleCustomInput();
        }

        function toggleCustomInput() {
          const model = document.getElementById('modelSelect').value;
          const customInput = document.getElementById('customModel');
          if (model === 'Other') {
            customInput.style.display = 'block';
            customInput.required = true;
          } else {
            customInput.style.display = 'none';
            customInput.required = false;
            customInput.value = '';
          }
        }

        document.getElementById('yearSelect').addEventListener('change', updateMakes);
        document.getElementById('makeSelect').addEventListener('change', updateModels);
        document.getElementById('modelSelect').addEventListener('change', toggleCustomInput);

        document.getElementById('quoteForm').addEventListener('submit', async function(e) {
          e.preventDefault();

          const successMsg = document.getElementById('successMessage');
          const errorMsg = document.getElementById('errorMessage');
          const errorText = document.getElementById('errorText');

          successMsg.style.display = 'none';
          errorMsg.style.display = 'none';

          const model = document.getElementById('modelSelect').value;
          const customModel = document.getElementById('customModel').value;
          const finalModel = model === 'Other' ? customModel : model;

          const formData = new FormData();
          formData.append('name', document.querySelector('input[name="name"]').value);
          formData.append('phone', document.querySelector('input[name="phone"]').value);
          formData.append('year', document.getElementById('yearSelect').value);
          formData.append('make', document.getElementById('makeSelect').value);
          formData.append('model', finalModel);

          const photoUpload = document.getElementById('photo-upload').files[0];
          const photoCamera = document.getElementById('photo-camera').files[0];
          const photoFile = photoUpload || photoCamera;
          if (photoFile) {
            formData.append('photo', photoFile);
          }

          try {
            const response = await fetch('/api/leads', {
              method: 'POST',
              body: formData,
            });

            const data = await response.json();

            if (response.ok && data.success) {
              successMsg.style.display = 'block';
              document.getElementById('quoteForm').reset();
              document.getElementById('makeSelect').innerHTML = '<option value="">Make</option>';
              document.getElementById('modelSelect').innerHTML = '<option value="">Model</option>';
              document.getElementById('customModel').style.display = 'none';
            } else {
              errorText.textContent = data.error || 'Failed to submit quote request';
              errorMsg.style.display = 'block';
            }
          } catch (err) {
            errorText.textContent = 'An error occurred. Please try again.';
            errorMsg.style.display = 'block';
            console.error('Submission error:', err);
          }
        });
      </script>

      <h2 class="mt-lg">Call for Immediate Help</h2>
      <p>
        <strong>Phone:</strong> <a href="tel:{{ site.phoneTracking }}">{{ site.phone }}</a><br>
        <strong>Available:</strong> Monday – Friday {{ site.hours.monday }}, Saturday {{ site.hours.saturday }}
      </p>

      <h3>Service Area</h3>
      <p>We serve Victorville, Hesperia, Apple Valley, Adelanto, Oak Hills, and surrounding areas throughout the High Desert with fast mobile repair and same-day appointments.</p>
    </div>

    <div class="service-sidebar">
      <div class="sidebar-box contact-box">
        <h3>Fastest Option: Call</h3>
        <a href="tel:{{ site.phoneTracking }}" class="phone-link">{{ site.phone }}</a>
        <p class="text-small">Exact quote in ~5 minutes</p>
      </div>

      <div class="sidebar-box">
        <h3>What to Have Ready</h3>
        <ul class="checklist">
          <li>Vehicle year, make, model</li>
          <li>Which glass is damaged</li>
          <li>Size of the damage</li>
          <li>Your insurance info (optional)</li>
        </ul>
    </div>
  </div>
</section>
